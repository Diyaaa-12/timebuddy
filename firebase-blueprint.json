{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A task with a deadline, estimated effort, status, and agent scheduling/priority metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "deadline": { "type": "string", "format": "date-time" },
        "estimatedEffort": { "type": "integer", "description": "Estimated effort in minutes" },
        "status": { "type": "string", "enum": ["pending", "completed", "missed", "at_risk"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "draftMessage": { "type": "string" },
        "approved": { "type": "boolean" },
        "scheduledStart": { "type": "string" },
        "scheduledEnd": { "type": "string" },
        "priorityScore": { "type": "number" },
        "riskReason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "deadline", "estimatedEffort", "status"]
    },
    "AgentReasoning": {
      "title": "Agent Reasoning",
      "description": "The explanatory reasoning text generated by the agent for why the user's daily tasks are organized, scheduled, and prioritized this way.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "reasoning": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "reasoning", "updatedAt"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks created by users."
    },
    "/reasonings/{reasoningId}": {
      "schema": "AgentReasoning",
      "description": "Reasoning entries generated by the Gemini server for each user."
    }
  }
}
